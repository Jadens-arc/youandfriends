{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm format:*)",
      "Bash(pnpm release-check)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter @youandfriends/db migrate:dry)",
      "Bash(pnpm --filter @youandfriends/db generate)",
      "Bash(pnpm --filter @youandfriends/db seed)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe:*)",
      "Bash(docker compose -f docker-compose.test.yml:*)",
      "Read(//home/user/youandfriends/**)",
      "Glob(//home/user/youandfriends/**)",
      "Grep(//home/user/youandfriends/**)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf /*)",
      "Bash(pnpm --filter @youandfriends/db migrate)",
      "Bash(pnpm --filter @youandfriends/jobs deploy)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.*.local)"
    ]
  }
}
