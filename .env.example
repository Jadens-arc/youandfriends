# You & Friends — environment variables
# A private music workspace by Avery and Friends. https://youandfriends.org
#
# Copy to `.env.local` and fill in real values. NEVER commit a file containing real values.
# Task `002` adds Zod validation that fails loudly at startup on a missing required variable.

# ─── Database — Neon Postgres ────────────────────────────────────────────────────────────
# Pooled connection for route handlers. From the Neon dashboard → Connection Details.
DATABASE_URL=
# Direct (non-pooled) connection. Required for migrations and transactional jobs, because
# Neon's serverless HTTP driver does not support interactive transactions.
DATABASE_URL_UNPOOLED=

# ─── Authentication — Clerk ──────────────────────────────────────────────────────────────
# From the Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: signing secret for Clerk webhooks, if used.
CLERK_WEBHOOK_SECRET=

# ─── Object storage — Cloudflare R2 (S3-compatible) ──────────────────────────────────────
# From the Cloudflare dashboard → R2 → Manage API Tokens. See ADR 0001.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Two private buckets. Never apply a public bucket policy to either.
R2_BUCKET_ORIGINALS=
R2_BUCKET_DERIVATIVES=
# Optional: S3 API endpoint override. Defaults to the R2 endpoint for your account.
R2_ENDPOINT=

# ─── Real-time collaboration — Liveblocks ────────────────────────────────────────────────
# From the Liveblocks dashboard → API keys. See ADR 0003.
LIVEBLOCKS_SECRET_KEY=
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# ─── Background media jobs — Trigger.dev ─────────────────────────────────────────────────
# From the Trigger.dev dashboard. See ADR 0002.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
# Optional: self-hosted Trigger.dev API URL.
TRIGGER_API_URL=

# ─── Email delivery — Resend (optional) ──────────────────────────────────────────────────
# When absent, email notification options degrade visibly rather than failing silently.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ─── Observability — Sentry (optional) ───────────────────────────────────────────────────
# When no DSN is set, error reporting is a silent no-op and nothing throws.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Product configuration ───────────────────────────────────────────────────────────────
# Maximum size of a single uploaded object, in bytes. Default 2 GB.
YOUANDFRIENDS_MAX_OBJECT_BYTES=2147483648
# Storage quota per workspace, in bytes. Default 100 GB. See ADR 0001 for the cost model.
YOUANDFRIENDS_WORKSPACE_QUOTA_BYTES=107374182400
# Streaming derivative bitrate, e.g. 192k. See ADR 0004.
YOUANDFRIENDS_DERIVATIVE_BITRATE=192k
# Presigned URL lifetimes, in seconds.
YOUANDFRIENDS_STREAM_URL_TTL_SECONDS=900
YOUANDFRIENDS_DOWNLOAD_URL_TTL_SECONDS=300
# Soft-delete recovery window, in days.
YOUANDFRIENDS_RECOVERY_WINDOW_DAYS=30

# ─── Local development and testing ───────────────────────────────────────────────────────
# MinIO stands in for R2 in contract tests (task `052`). Not used in production.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
