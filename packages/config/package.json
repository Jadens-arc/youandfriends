{
  "name": "@youandfriends/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./src/eslint/index.mjs",
    "./eslint/react": "./src/eslint/react.mjs",
    "./vitest/node": "./src/vitest/node.ts",
    "./vitest/react": "./src/vitest/react.ts",
    "./eslint/boundaries": "./src/eslint/boundaries.mjs",
    "./eslint/rules": "./src/eslint/rules/index.mjs",
    "./fixtures": "./src/fixtures/credentials.ts"
