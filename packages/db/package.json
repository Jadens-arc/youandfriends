{
  "name": "@youandfriends/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, and the typed Neon client. The durable record.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/__tests__/index.ts",
    "./seed": "./src/seed/public.ts",
    "./env-file": "./src/env-file.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "lint": "eslint .",
    "migrate": "tsx bin/migrate.mjs",
    "migrate:dry": "tsx bin/migrate-dry.mjs",
    "ops:uploads:sweep": "tsx bin/uploads-sweep.mjs",
    "purge": "tsx bin/purge.mjs",
    "seed": "tsx bin/seed.mjs",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@youandfriends/config": "workspace:*",
    "@youandfriends/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@youandfriends/config": "workspace:*",
    "@youandfriends/storage": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
