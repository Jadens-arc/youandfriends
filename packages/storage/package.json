  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@youandfriends/config": "workspace:*",
    "@youandfriends/contracts": "workspace:*"
  },
  "devDependencies": {
    "@youandfriends/config": "workspace:*",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
